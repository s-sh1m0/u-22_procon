# GitHub OAuth
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
GITHUB_CALLBACK_URL=http://localhost/auth/github/callback

# Backend
PORT=8080
SESSION_SECRET=change_this_to_random_string
DB_PATH=/app/data/reviewarena.db

# 解析ジョブ（任意・省略時はデフォルト値）
# JOB_WORKERS: 同時に走らせる解析ワーカー数（省略時 = min(CPU数, 4)）。
#   1ジョブは型チェック＋SSA/CHA で CPU/メモリを多く使うため、GOMEMLIMIT/mem_limit と合わせて調整する。
# JOB_TIMEOUT_SECONDS: 1ジョブの解析時間上限（省略時 120）。巨大リポジトリの暴走対策。
# JOB_QUEUE_BUFFER: ジョブキューのバッファ長（省略時 32）。
# JOB_WORKERS=4
# JOB_TIMEOUT_SECONDS=120
# JOB_QUEUE_BUFFER=32

# --- デプロイ (Vercel + Render) ---
# FRONTEND_URL: フロントエンドのオリジン (例: https://xxx.vercel.app)
#   CORS 許可オリジン / OAuth 後リダイレクト先に使用。
#   ローカル開発(nginx 同一オリジン)では空のままにする。
# FRONTEND_URL=https://xxx.vercel.app

# VITE_API_BASE_URL: バックエンドの URL (例: https://xxx.onrender.com)
#   フロントエンドの fetch / OAuth リンクに使用。
#   ローカル開発(nginx 同一オリジン)では空のままにする。
# VITE_API_BASE_URL=https://xxx.onrender.com
